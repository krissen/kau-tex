\RequirePackage{kau-style}

\DeclareOptionBeamer{compress}{\beamer@compresstrue}

\newif\ifbeamer@kau@sections
\beamer@kau@sectionsfalse
\DeclareOptionBeamer{sections}[none]{%
  \def\beamer@kau@sectionsvalue{#1}%
  \def\beamer@kau@sectionsdividers{dividers}%
  \ifx\beamer@kau@sectionsvalue\beamer@kau@sectionsdividers
    \beamer@kau@sectionstrue
  \else
    \beamer@kau@sectionsfalse
  \fi
}

\newif\ifbeamer@kau@titlelogo
\beamer@kau@titlelogotrue
\DeclareOptionBeamer{title-logo}[true]{%
  \def\beamer@kau@titlelogovalue{#1}%
  \def\beamer@kau@titlelogofalsevalue{false}%
  \ifx\beamer@kau@titlelogovalue\beamer@kau@titlelogofalsevalue
    \beamer@kau@titlelogofalse
  \else
    \beamer@kau@titlelogotrue
  \fi
}
\DeclareOptionBeamer{nologo}{\beamer@kau@titlelogofalse}

\newif\ifbeamer@kau@lightframesubtitle
\beamer@kau@lightframesubtitlefalse
\DeclareOptionBeamer{framesubtitle}[canonical]{%
  \def\beamer@kau@fsvalue{#1}%
  \def\beamer@kau@fslight{light}%
  \ifx\beamer@kau@fsvalue\beamer@kau@fslight
    \beamer@kau@lightframesubtitletrue
  \else
    \beamer@kau@lightframesubtitlefalse
  \fi
}

\ProcessOptionsBeamer

\mode<presentation>

% Inner themes such as rounded set the title and section page templates to
% the beamer default. Append a re-apply to \beamer@calltheme, which every
% \useinnertheme (and the other theme commands) goes through. A document
% that sets its own template afterwards still wins.
\RequirePackage{etoolbox}
\newcommand\sola@settemplates{%
  \setbeamertemplate{title page}[Sola]%
  \setbeamertemplate{section page}[Sola]%
}
\ifdefined\sola@calltheme@patched\else
  \apptocmd{\beamer@calltheme}{\sola@settemplates}{}{}%
  \def\sola@calltheme@patched{}%
\fi

% Profile typography. Adobe's fonts are used when present; otherwise fall
% back to system Helvetica/Arial and finally to a plain sans.
\RequirePackage{fontspec}
\usefonttheme{professionalfonts}

\newcommand\kauSola@adobepath{/Users/krisniem/Library/Application Support/Adobe/.User Owned Fonts/}
\newcommand\kauSola@font[3]{%
  \IfFileExists{\kauSola@adobepath#2}{%
    \newfontfamily#1[Path={\kauSola@adobepath},UprightFont={#2}]{#2}%
  }{%
    \newcommand#1{#3}%
  }%
}
\kauSola@font{\kauLXXVII}{Helvetica Neue LT Com 77 Bold Condensed-13b6.otf}{\sffamily\bfseries}
\kauSola@font{\kauLXVII}{Helvetica Neue LT Com 67 Medium Condensed-f3ce.otf}{\sffamily\mdseries}
\kauSola@font{\kauLVII}{Helvetica Neue LT Com 57 Condensed-4b51.otf}{\sffamily\mdseries}
\kauSola@font{\kauXLVII}{Helvetica Neue LT Com 47 Light Condensed-1db6.otf}{\sffamily\mdseries}

\IfFontExistsTF{Helvetica Neue}{\setsansfont{Helvetica Neue}}{%
  \IfFontExistsTF{Arial}{\setsansfont{Arial}}{%
    \IfFontExistsTF{Helvetica}{\setsansfont{Helvetica}}{}%
  }%
}

\setbeamerfont{title}{family=\kauLXXVII,size={\fontsize{23}{27}\selectfont}}
\setbeamerfont{subtitle}{family=\kauLVII,size=\large}
\setbeamerfont{frametitle}{family=\kauLXVII,series=\mdseries,size=\Large}
\ifbeamer@kau@lightframesubtitle
  \setbeamerfont{framesubtitle}{family=\kauXLVII,series=\mdseries,size=\large}
\else
  \setbeamerfont{framesubtitle}{family=\kauLVII,series=\mdseries,size=\large}
\fi
\setbeamerfont{block title}{size=\normalsize}
\setbeamerfont{block body}{size=\small}
\setbeamerfont{itemize/enumerate body}{size=\small}
\setbeamerfont{description body}{size=\small}

\setbeamercolor{section in head/foot}{use=structure,bg=structure.fg!25!bg}

\setbeamercolor{description item}{fg=kaugul!75!red!75!black}
\setbeamerfont{description item}{series=\bf}

\useoutertheme[subsection=false]{miniframes}

\setbeamertemplate{frametitle}[default][center]
\setbeamertemplate{navigation symbols}{}
% No logo on content slides; the title page has its own logo.
\setbeamertemplate{logo}{}
\setbeamercolor{lower separation line head}{bg=black}

% Title page from the approved profile layout (kaumall). The KAU logo is
% on by default and comes from \kausetup{logo=...}; extra logos and a
% contributor block are optional additions.
\providecommand\kautitleheader{}
\providecommand\kautitlebody{}
\defbeamertemplate*{title page}{Sola}[1][]{%
  \vspace*{1cm}%
  \usebeamercolor{structure}%
  \begin{beamercolorbox}[wd=\paperwidth,ht=\dimexpr 8ex+0.7mm\relax,dp=\dimexpr 3ex-0.7mm\relax,right]{title}%
    \kautitleheader
    \usebeamerfont{title}\inserttitle\hspace*{10mm}\par
    \usebeamerfont{subtitle}\usebeamercolor{subtitle}\insertsubtitle\hspace*{10mm}\par
  \end{beamercolorbox}%
  \kautitlebody
  \bigskip
  \begin{flushright}
    \usebeamerfont{author}\insertauthor\par
    \usebeamerfont{institute}\insertinstitute\par
    \medskip
    \usebeamerfont{date}\insertdate\par
  \end{flushright}
  \vfill
  \kauifcontributors
    {{\raggedleft\scriptsize \kaucontributors\par}\vspace{0.5cm}}{}%
  \ifbeamer@kau@titlelogo
    \kauiflogo
      {%
        \IfFileExists{\kaulogo}
          { \includegraphics[width=0.15\paperwidth]{\kaulogo} }
          { \PackageWarning{beamerthemeSola}{Logo file not found: \kaulogo} }%
      }{}%
  \fi
  \kauiftitlelogos{\hspace{0.5em}\kauinserttitlelogos}{}%
  \kauiftitleextra{\par\vspace{0.3cm}\kautitleextracontent}{}%
  \vspace*{0.8cm}%
}
\setbeamertemplate{title page}[Sola]
\defbeamertemplatealias{title page}{SingaporeKAU}{Sola}

\AtBeginDocument{%
    \pgfdeclareverticalshading{beamer@headfade}{\paperwidth}
  {%
    color(0cm)=(kaugul);
    color(1.25cm)=(white!65!kaugul)%
  }%
  \setbeamercolor{section in head/foot}{bg=}%
  % Documents and included fragments still say craneorange. The crane
  % colour theme may have redefined it to orange, so restore the KAU
  % yellow at the last moment.
  \colorlet{craneorange}{kaugul}%
}

\defbeamertemplate*{headline}{Sola frames}{%
  \begin{beamercolorbox}[colsep=1.5pt]{upper separation line head}
  \end{beamercolorbox}%
  \begin{beamercolorbox}{section in head/foot}
    \vskip2pt\insertnavigation{\paperwidth}\vskip2pt
  \end{beamercolorbox}%
  \ifbeamer@theme@subsection%
    \begin{beamercolorbox}[colsep=1.5pt]{middle separation line head}
    \end{beamercolorbox}%
    \begin{beamercolorbox}[ht=2.5ex,dp=1.125ex,%
      leftskip=.3cm,rightskip=.3cm plus1fil]{subsection in head/foot}
      \usebeamerfont{subsection in head/foot}\insertsubsectionhead
    \end{beamercolorbox}%
  \fi%
  \begin{beamercolorbox}[colsep=0.15pt]{lower separation line head}
  \end{beamercolorbox}%
}

\setbeamertemplate{headline}[Sola frames]

\addtoheadtemplate{\pgfuseshading{beamer@headfade}\vskip-1.25cm}{}

\beamertemplatedotitem

% Section dividers: opt in with \usetheme[sections=dividers]{Sola}, or
% typeset a single one with \kausectionpage[optional title].
\providecommand\kausectionheader{}
\providecommand\kausectionbody{}
\defbeamertemplate*{section page}{Sola}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=12ex,dp=4ex,left]{title}
    \kausectionheader
    \hspace*{10mm}{\kauLXXVII\Huge\insertsectionhead\par}%
  \end{beamercolorbox}%
  \kausectionbody
  \vfill
}
\setbeamertemplate{section page}[Sola]
\defbeamertemplatealias{section page}{SingaporeKAU}{Sola}

\NewDocumentCommand \kausectionpage { O{} }
  {
    \begin{frame}[plain]
      \if\relax\detokenize{#1}\relax
        \sectionpage
      \else
        \begingroup
          \def\insertsectionhead{#1}%
          \sectionpage
        \endgroup
      \fi
    \end{frame}
  }

\ifbeamer@kau@sections
  \AtBeginSection[]{\kausectionpage}
\fi

\mode<all>

\endinput
